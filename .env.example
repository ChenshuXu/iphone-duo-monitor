# Exact browser address, without a trailing slash. Changing PORT also needs this.
PUBLIC_ORIGIN=http://localhost:8088
BIND_ADDRESS=127.0.0.1
PORT=8088
# Fill only the channels you use. Never commit .env.
BARK_KEY=
GRAFANA_IRM_WEBHOOK=
# Optional hostname pin; normally inferred from the official Grafana webhook.
GRAFANA_IRM_HOST=
# Optional bind directory for an existing installation; default is a named volume.
DATA_VOLUME=monitor-data
